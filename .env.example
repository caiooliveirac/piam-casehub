APP_ENV=development
APP_NAME="PIAM CaseHub"
BASE_URL=https://piam.mnrs.com.br

DATABASE_URL=postgresql+psycopg://piam:piam@db:5432/piam
POSTGRES_DB=piam
POSTGRES_USER=piam
POSTGRES_PASSWORD=change-me

# Telegram — documented names. The app also accepts ADMIN_ID / GROUP_ID
# as fallbacks for backward compatibility with earlier .env files.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_ID=
TELEGRAM_GROUP_ID=

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

SECRET_KEY=change-me
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=25

TZ=America/Bahia

# --- Deploy (filled per-environment; never commit real values) ---
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PATH=/home/ubuntu/piam-casehub
DEPLOY_SSH_KEY=
